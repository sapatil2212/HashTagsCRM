# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=ef0713728e472fa6e970160dddb965d31a3fc736fd9e0515eb684fdfe6f05ddb

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request. A per-tenant
# secret saved in Settings → WhatsApp takes precedence over this value.
# Step-by-step: docs/META_WHATSAPP_SETUP.md
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap, OG images, and any email the app
# sends. Defaults to https://wacrm.tech if unset.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Global fallback for Meta's webhook verification handshake (GET
# /api/whatsapp/webhook). Checked before the per-tenant verify tokens
# stored in Settings → WhatsApp, so it lets you verify the webhook in
# Meta before any tenant has saved credentials — handy for local tunnels.
# Must match the "Verify token" you type into the Meta App Dashboard.
# WEBHOOK_VERIFY_TOKEN=generate-a-random-string

# ============================================================
# AI HEALTHCARE AUTOMATION — API Keys
# ============================================================

# Google Gemini API Key (PRIMARY — required for AI auto-replies).
# Get it from: https://aistudio.google.com/app/apikey
# The cascade is: Gemini → OpenRouter → OpenAI.
GEMINI_API_KEY=your-gemini-api-key

# Optional: pin a specific Gemini model instead of the default cascade
# (gemini-3.6-flash → gemini-2.5-flash → gemini-2.0-flash). Older 2.x
# aliases return 404 "no longer available" on newly issued keys.
# GEMINI_MODEL=gemini-3.6-flash

# OpenRouter API Key (FALLBACK — optional but recommended for resilience).
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI API Key (LAST FALLBACK — optional).
# An sk-or-v1-... value here is detected as an OpenRouter token and routed
# to OpenRouter instead of api.openai.com. If no key is set, AI replies are off.
OPENAI_API_KEY=your-openai-api-key

# Google Sheets Webhook URL (OPTIONAL — for syncing booked appointments).
# Deploy the Google Apps Script in docs/google-sheets-script.js as a Web App
# (Execute as: Me, Who has access: Anyone), copy the /exec URL here.
# If unset, appointments are saved to Supabase only (no Sheets sync).
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ============================================================
# BILLING — Safepay payment gateway
# ============================================================
# Without these, checkout returns 501 and accounts can only be activated
# manually from the Super Admin portal. Everything else keeps working.
# Step-by-step: docs/SAFEPAY_SETUP.md

# Which Safepay environment to talk to: sandbox or production.
# Defaults to sandbox when unset — an operator who forgets this runs test
# transactions rather than unknowingly charging real cards.
SAFEPAY_ENVIRONMENT=sandbox

# API key, labelled "Public key" in the Safepay dashboard (sec_...).
# Despite the name it is NOT public: anyone holding it can open payment
# sessions that bill your merchant account. Server-side only — it has no
# NEXT_PUBLIC_ twin, and adding one would leak it to every browser.
SAFEPAY_API_KEY=sec_00000000-0000-0000-0000-000000000000

# Secret key (64 hex chars), from the same dashboard page. Verifies the
# HMAC-SHA256 `sig` on the browser's return from checkout, which is what
# stops a customer forging a "payment succeeded" round trip.
SAFEPAY_SECRET_KEY=your-safepay-secret-key

# Webhook secret (Developer settings → Webhooks). Verifies the
# HMAC-SHA512 X-SFPY-SIGNATURE on server-to-server callbacks — the
# authoritative settlement path. Falls back to SAFEPAY_SECRET_KEY when
# unset, because several official Safepay plugins share one secret for
# both; setting a dedicated value is still strictly better.
# SAFEPAY_WEBHOOK_SECRET=your-safepay-webhook-secret

# Attribution tag sent on the checkout URL. Safepay's current guides use
# "hosted" for browser redirect flows, which is the default here; their
# Node SDK uses "custom". Only change this if Safepay support asks.
# SAFEPAY_CHECKOUT_SOURCE=hosted

# Shared secret protecting GET /api/billing/cron, which ages out abandoned
# checkouts, expires lapsed subscriptions, and reconciles any payment that
# settled without its subscription advancing. Reuses the same variable as
# the automations cron. Ping it hourly.
#   AUTOMATION_CRON_SECRET=generate-a-long-random-string

# NOTE: NEXT_PUBLIC_SITE_URL (above) must be correct and publicly
# reachable. Safepay redirects the customer back to it and posts webhooks
# to it, so localhost only works behind a tunnel.

# ============================================================
# FILE STORAGE (avatars, portfolio thumbnails)
# ============================================================
# Uploads are stored on THIS server's disk — no third-party service. This
# replaced Cloudinary, so any CLOUDINARY_* variables are obsolete and can be
# removed. Both variables below are OPTIONAL; the defaults work out of the box.

# Absolute directory to write uploads to. Defaults to <project>/public/uploads,
# which Next.js serves automatically at /uploads/... — no web-server config
# needed. Point this at a dedicated volume (e.g. /var/www/uploads) only if you
# also serve UPLOAD_PUBLIC_BASE_PATH from that directory via your reverse proxy.
# UPLOAD_DIR=/var/www/hashtagscrm-uploads

# Public URL prefix the browser requests for stored files. Must map to
# UPLOAD_DIR. Defaults to /uploads. Leave unset unless you moved UPLOAD_DIR
# outside public/ and wired up nginx to serve it.
# UPLOAD_PUBLIC_BASE_PATH=/uploads
